{
  "name": "deepseek-credit-status",
  "displayName": "DeepSeek Credit Status — API Balance Monitor",
  "description": "Monitor your DeepSeek API credits and balance in the VS Code status bar. Real-time credit tracking, unmissable low-balance alerts, daily spend estimates, USD/CNY support, and one-click top-up. Available in English and 简体中文. New! Surge pricing monitoring.",
  "version": "1.2.2",
  "publisher": "pantsari",
  "license": "MIT",
  "icon": "appicon.png",
  "galleryBanner": {
    "color": "#4D6BFE",
    "theme": "dark"
  },
  "screenshots": [
    {
      "path": "https://raw.githubusercontent.com/pantsari/deepseek-usage-tracker/main/Deepseek%20usage%20bar.png",
      "caption": "Status bar showing DeepSeek balance"
    },
    {
      "path": "https://raw.githubusercontent.com/pantsari/deepseek-usage-tracker/main/Command%20palette%20settings.png",
      "caption": "Command Palette with DeepSeek settings"
    }
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "deepseek",
    "balance",
    "credits",
    "credit",
    "usage",
    "api",
    "monitor",
    "status bar",
    "billing",
    "warning",
    "alert",
    "token",
    "top-up",
    "notifications",
    "surge",
    "pricing",
    "off-peak",
    "spending",
    "tracker",
    "status",
    "low balance",
    "spend",
    "中文"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "title": "DeepSeek Credit Status",
      "properties": {
        "deepseek-usage.warningThresholds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "default": [
            10,
            5,
            1
          ],
          "markdownDescription": "%config.warningThresholds.description%"
        },
        "deepseek-usage.refreshIntervalMinutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 120,
          "default": 5,
          "description": "%config.refreshIntervalMinutes.description%"
        }
      }
    },
    "commands": [
      {
        "command": "deepseek-usage.click",
        "title": "%command.click.title%",
        "category": "DeepSeek"
      },
      {
        "command": "deepseek-usage.refresh",
        "title": "%command.refresh.title%",
        "category": "DeepSeek"
      },
      {
        "command": "deepseek-usage.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "DeepSeek"
      },
      {
        "command": "deepseek-usage.configureWarnings",
        "title": "%command.configureWarnings.title%",
        "category": "DeepSeek"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "setApiKey",
            "title": "%walkthrough.setApiKey.title%",
            "description": "%walkthrough.setApiKey.description%",
            "media": {
              "markdown": "walkthrough/set-api-key.md"
            },
            "completionEvents": [
              "onCommand:deepseek-usage.setApiKey"
            ]
          },
          {
            "id": "viewBalance",
            "title": "%walkthrough.viewBalance.title%",
            "description": "%walkthrough.viewBalance.description%",
            "media": {
              "markdown": "walkthrough/view-balance.md"
            },
            "completionEvents": [
              "onCommand:deepseek-usage.click"
            ]
          },
          {
            "id": "configureWarnings",
            "title": "%walkthrough.configureWarnings.title%",
            "description": "%walkthrough.configureWarnings.description%",
            "media": {
              "markdown": "walkthrough/configure-warnings.md"
            },
            "completionEvents": [
              "onCommand:deepseek-usage.configureWarnings"
            ]
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pantsari/deepseek-usage-tracker"
  },
  "bugs": {
    "url": "https://github.com/pantsari/deepseek-usage-tracker/issues"
  },
  "scripts": {
    "package": "vsce package",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
